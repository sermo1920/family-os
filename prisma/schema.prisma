// Nommage générique (Household/Member) pour que de futurs modules Family OS
// (calendrier, tâches, budget...) puissent réutiliser ces mêmes entités.
// Voir le plan de conception pour le schéma complet prévu (Phases 2 à 5).

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Household {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  members       Member[]
  ingredients   Ingredient[]
  recipes       Recipe[]
  plannedMeals  PlannedMeal[]
  shoppingLists ShoppingList[]
  invitations   HouseholdInvitation[]
  preferences   HouseholdPreference[]
  pantryItems   PantryItem[]
  conversations Conversation[]
}

// Une personne du foyer. Pas tous les membres ne peuvent se connecter
// (ex: un enfant) : linkedUserId est optionnel et pointe vers l'utilisateur
// Supabase Auth correspondant quand il existe.
model Member {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id])

  linkedUserId String?    @unique
  // Copié depuis Supabase Auth à la création (jamais modifiable dans l'app :
  // le vrai compte reste géré par Supabase). Distinct de displayName, qui est
  // le nom affiché et librement modifiable.
  email        String?
  displayName  String
  role         MemberRole @default(ADULT)

  dateOfBirth   DateTime?
  sex           Sex?
  heightCm      Float?
  weightKg      Float?
  activityLevel ActivityLevel?

  // Lien iCal public/privé (Google "adresse secrète", Outlook "lien ICS
  // publié", etc.) — lu en lecture seule au moment d'afficher le planning,
  // jamais stocké en cache côté serveur (voir features/household/calendar.ts).
  icsCalendarUrl String?
  // Couleur personnelle affichée dans l'agenda de la semaine (pastille) à la
  // place d'écrire le nom du membre à côté de chaque événement.
  color          MemberColor?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nutritionGoals  NutritionGoal[]
  mealAttendances MealAttendance[]
  invitation      HouseholdInvitation?
  conversations   Conversation[]
}

// Invitation à rejoindre le foyer en tant que `member` (déjà créé sans
// compte, ex: via "Ajouter un membre"). Le lien contenant `token` est généré
// dans l'app puis partagé manuellement par le propriétaire (e-mail, SMS,
// WhatsApp...) — pas d'envoi automatique, donc pas besoin d'un service
// d'e-mail tiers. `acceptedAt` empêche de réutiliser un lien déjà consommé.
model HouseholdInvitation {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  memberId    String    @unique
  member      Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  email String? // indicatif seulement, non vérifié à l'acceptation
  token String  @unique

  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())
}

// Historique versionné : la ligne la plus récente (createdAt) pour un membre
// est son objectif courant. On ne modifie jamais une ligne existante, ce qui
// donne un historique gratuit (utile pour suivre l'évolution dans le temps).
model NutritionGoal {
  id       String @id @default(cuid())
  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  // Valeurs calculées à partir du profil au moment du calcul (pour audit/
  // historique, même si l'utilisateur modifie ensuite manuellement la cible).
  bmr  Float
  tdee Float

  calorieTarget Int
  proteinG      Int
  carbsG        Int
  fatG          Int

  isManualOverride Boolean @default(false)
  notes            String?

  createdAt DateTime @default(now())
}

// Catalogue par foyer (pas de base d'ingrédients globale à administrer).
model Ingredient {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id])

  name     String
  category IngredientCategory
  baseUnit Unit

  // Valeurs nutritionnelles pour 100 g ou 100 ml (selon baseUnit).
  // Optionnelles : un ingrédient créé par l'agent cuisine (ou pour le stock)
  // n'a pas de valeurs connues — on ne les invente jamais (null = inconnu,
  // jamais 0).
  caloriesPer100 Float?
  proteinPer100  Float?
  carbsPer100    Float?
  fatPer100      Float?

  createdAt DateTime @default(now())

  recipeIngredients RecipeIngredient[]
  shoppingListItems ShoppingListItem[]
  pantryItem        PantryItem?
}

model Recipe {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id])

  name         String
  // Étapes, une par ligne (affichées numérotées).
  instructions String?
  servings     Int     @default(1)

  // AI_PROPOSED : créée par l'agent cuisine, pas encore validée par le foyer.
  status          RecipeStatus @default(VALIDATED)
  prepTimeMinutes Int?
  cookTimeMinutes Int?
  tags            RecipeTag[]  @default([])
  // Appréciation du foyer (1 à 5) et remarques/modifications libres.
  rating          Int?
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  ingredients  RecipeIngredient[]
  plannedMeals PlannedMeal[]
}

// Relation many-to-many avec quantité (exprimée dans l'unité de l'ingrédient).
model RecipeIngredient {
  id           String     @id @default(cuid())
  recipeId     String
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])

  quantity Float

  @@unique([recipeId, ingredientId])
}

// Un repas planifié pour un jour + créneau donné. Un seul par (foyer, jour,
// créneau) : réassigner une recette sur le même créneau remplace l'existant.
model PlannedMeal {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id])

  date     DateTime // jour seul (minuit UTC) ; l'heure n'est pas utilisée
  mealSlot MealSlot

  recipeId          String
  recipe            Recipe @relation(fields: [recipeId], references: [id])
  portionMultiplier Float  @default(1)

  // PROPOSED : posé par l'agent cuisine, pas encore validé. Seuls les repas
  // VALIDATED alimentent la liste de courses (voir features/shopping-list/sync.ts).
  status MealStatus @default(VALIDATED)
  notes  String?

  // Repas de restes : pointe vers le repas cuisiné en plus grande quantité.
  // Ses ingrédients ne sont ni achetés ni décomptés du stock une seconde fois.
  leftoverOfId String?
  leftoverOf   PlannedMeal?  @relation("Leftovers", fields: [leftoverOfId], references: [id], onDelete: SetNull)
  leftovers    PlannedMeal[] @relation("Leftovers")

  // Renseigné par l'action explicite "Marquer comme préparé", qui décrémente
  // le stock une seule fois (jamais au moment de la planification).
  preparedAt DateTime?

  createdAt DateTime @default(now())

  attendances MealAttendance[]

  @@unique([householdId, date, mealSlot])
}

// Quels membres du foyer mangent ce repas planifié.
model MealAttendance {
  id            String      @id @default(cuid())
  plannedMealId String
  plannedMeal   PlannedMeal @relation(fields: [plannedMealId], references: [id], onDelete: Cascade)
  memberId      String
  member        Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([plannedMealId, memberId])
}

// Générée à partir d'une plage de dates du planning (voir
// features/shopping-list/aggregate.ts pour le calcul).
model ShoppingList {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id])

  name      String
  // Optionnelles : une liste n'est plus forcément générée à partir d'une
  // plage de dates du planning (voir importPlannedMeals) — elle peut être
  // un simple panier créé à la main. Gardées pour l'affichage des listes
  // historiques créées avec l'ancien flux (une seule génération = une plage).
  startDate DateTime?
  endDate   DateTime?

  createdAt DateTime @default(now())

  items ShoppingListItem[]
}

model ShoppingListItem {
  id             String       @id @default(cuid())
  shoppingListId String
  shoppingList   ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)

  // Lien optionnel vers l'ingrédient source (null pour un article ajouté
  // manuellement). name/category sont toujours copiés à la création, donc
  // l'affichage ne dépend jamais de ce lien et reste stable même si
  // l'ingrédient source est ensuite renommé ou supprimé.
  ingredientId String?
  ingredient   Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: SetNull)
  name         String

  category IngredientCategory
  quantity Float
  unit     Unit

  // MEAL_PLAN : calculé depuis le menu validé, recalculé à chaque
  // synchronisation. MANUAL : ajouté à la main, jamais touché par la synchro.
  source ShoppingItemSource @default(MANUAL)

  isChecked Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Préférences confirmées du foyer (goûts, exclusions, contraintes, budget).
// Source de vérité pour l'agent cuisine, consultable/modifiable dans /preferences.
model HouseholdPreference {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  kind PreferenceKind
  text String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([householdId])
}

// Stock simple : un ingrédient du catalogue et sa quantité si connue (dans
// l'unité de base de l'ingrédient). quantity null = présent, quantité
// inconnue — jamais déduit des besoins dans ce cas.
model PantryItem {
  id           String     @id @default(cuid())
  householdId  String
  household    Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  ingredientId String     @unique
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  quantity Float?

  updatedAt DateTime @updatedAt

  @@index([householdId])
}

// Conversation avec le coordinateur. Le contenu utile (recettes, menus,
// listes) vit dans les tables métier : l'historique ne sert qu'à comprendre
// les références ("remplace celui de jeudi").
model Conversation {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  memberId    String
  member      Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  title String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ConversationMessage[]

  @@index([memberId, updatedAt])
}

model ConversationMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role    ConversationRole
  content String
  // Journal déterministe des écritures réellement effectuées pendant ce tour
  // (voir features/assistant/actions-log.ts), affiché sous la réponse.
  actions Json?
  isError Boolean          @default(false)

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
}

enum RecipeStatus {
  AI_PROPOSED
  VALIDATED
}

enum RecipeTag {
  QUICK
  VEGETARIAN
  VEGAN
  MAKE_AHEAD
  FREEZABLE
  KID_FRIENDLY
  LIGHT
  BUDGET
  ONE_POT
}

enum MealStatus {
  PROPOSED
  VALIDATED
}

enum ShoppingItemSource {
  MANUAL
  MEAL_PLAN
}

enum PreferenceKind {
  LIKE
  DISLIKE
  EXCLUSION
  CONSTRAINT
  BUDGET
  OTHER
}

enum ConversationRole {
  USER
  ASSISTANT
}

enum MealSlot {
  BREAKFAST
  LUNCH
  DINNER
}

enum Unit {
  GRAM
  MILLILITER
  PIECE
  PACK
}

enum IngredientCategory {
  OTHER
  FRUITS_VEGETABLES
  MEAT
  FISH
  BAKERY
  FRESH
  FROZEN
  BEVERAGES
  STARCHES
  SAVORY_GROCERY
  CANNED
  READY_MEALS
  SAUCES_CONDIMENTS
  BREAKFAST
  COOKIES_CAKES
  CONFECTIONERY
  DESSERT
  BEAUTY_HYGIENE
  BABY
  CLEANING
  PETS
  HOME_GARDEN
  CONDIMENTS
}

enum MemberRole {
  OWNER
  ADULT
  CHILD
}

enum Sex {
  MALE
  FEMALE
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum MemberColor {
  RED
  ORANGE
  AMBER
  GREEN
  TEAL
  BLUE
  INDIGO
  PURPLE
  PINK
}
