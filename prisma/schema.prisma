// Nommage générique (Household/Member) pour que de futurs modules Family OS
// (calendrier, tâches, budget...) puissent réutiliser ces mêmes entités.
// Voir le plan de conception pour le schéma complet prévu (Phases 2 à 5).

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Household {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  members     Member[]
  ingredients Ingredient[]
  recipes     Recipe[]
}

// Une personne du foyer. Pas tous les membres ne peuvent se connecter
// (ex: un enfant) : linkedUserId est optionnel et pointe vers l'utilisateur
// Supabase Auth correspondant quand il existe.
model Member {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id])

  linkedUserId String? @unique
  displayName  String
  role         MemberRole @default(ADULT)

  dateOfBirth   DateTime?
  sex           Sex?
  heightCm      Float?
  weightKg      Float?
  activityLevel ActivityLevel?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nutritionGoals NutritionGoal[]
}

// Historique versionné : la ligne la plus récente (createdAt) pour un membre
// est son objectif courant. On ne modifie jamais une ligne existante, ce qui
// donne un historique gratuit (utile pour suivre l'évolution dans le temps).
model NutritionGoal {
  id       String @id @default(cuid())
  memberId String
  member   Member @relation(fields: [memberId], references: [id])

  // Valeurs calculées à partir du profil au moment du calcul (pour audit/
  // historique, même si l'utilisateur modifie ensuite manuellement la cible).
  bmr  Float
  tdee Float

  calorieTarget Int
  proteinG      Int
  carbsG        Int
  fatG          Int

  isManualOverride Boolean @default(false)
  notes            String?

  createdAt DateTime @default(now())
}

// Catalogue par foyer (pas de base d'ingrédients globale à administrer).
model Ingredient {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id])

  name     String
  category IngredientCategory
  baseUnit Unit

  // Valeurs nutritionnelles pour 100 g ou 100 ml (selon baseUnit).
  caloriesPer100 Float
  proteinPer100  Float
  carbsPer100    Float
  fatPer100      Float

  createdAt DateTime @default(now())

  recipeIngredients RecipeIngredient[]
}

model Recipe {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id])

  name         String
  instructions String?
  servings     Int      @default(1)

  createdAt DateTime @default(now())

  ingredients RecipeIngredient[]
}

// Relation many-to-many avec quantité (exprimée dans l'unité de l'ingrédient).
model RecipeIngredient {
  id           String     @id @default(cuid())
  recipeId     String
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])

  quantity Float

  @@unique([recipeId, ingredientId])
}

enum Unit {
  GRAM
  MILLILITER
}

enum IngredientCategory {
  FRUITS_VEGETABLES
  DAIRY
  MEAT_FISH
  GROCERY
  BAKERY
  BEVERAGES
  FROZEN
  OTHER
}

enum MemberRole {
  OWNER
  ADULT
  CHILD
}

enum Sex {
  MALE
  FEMALE
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}
