// Nommage générique (Household/Member) pour que de futurs modules Family OS
// (calendrier, tâches, budget...) puissent réutiliser ces mêmes entités.
// Voir le plan de conception pour le schéma complet prévu (Phases 2 à 5).

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Household {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  members       Member[]
  ingredients   Ingredient[]
  recipes       Recipe[]
  plannedMeals  PlannedMeal[]
  shoppingLists ShoppingList[]
  invitations   HouseholdInvitation[]
}

// Une personne du foyer. Pas tous les membres ne peuvent se connecter
// (ex: un enfant) : linkedUserId est optionnel et pointe vers l'utilisateur
// Supabase Auth correspondant quand il existe.
model Member {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id])

  linkedUserId String? @unique
  // Copié depuis Supabase Auth à la création (jamais modifiable dans l'app :
  // le vrai compte reste géré par Supabase). Distinct de displayName, qui est
  // le nom affiché et librement modifiable.
  email        String?
  displayName  String
  role         MemberRole @default(ADULT)

  dateOfBirth   DateTime?
  sex           Sex?
  heightCm      Float?
  weightKg      Float?
  activityLevel ActivityLevel?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nutritionGoals  NutritionGoal[]
  mealAttendances MealAttendance[]
  invitation      HouseholdInvitation?
}

// Invitation à rejoindre le foyer en tant que `member` (déjà créé sans
// compte, ex: via "Ajouter un membre"). Le lien contenant `token` est généré
// dans l'app puis partagé manuellement par le propriétaire (e-mail, SMS,
// WhatsApp...) — pas d'envoi automatique, donc pas besoin d'un service
// d'e-mail tiers. `acceptedAt` empêche de réutiliser un lien déjà consommé.
model HouseholdInvitation {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  memberId    String    @unique
  member      Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  email String? // indicatif seulement, non vérifié à l'acceptation
  token String  @unique

  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())
}

// Historique versionné : la ligne la plus récente (createdAt) pour un membre
// est son objectif courant. On ne modifie jamais une ligne existante, ce qui
// donne un historique gratuit (utile pour suivre l'évolution dans le temps).
model NutritionGoal {
  id       String @id @default(cuid())
  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  // Valeurs calculées à partir du profil au moment du calcul (pour audit/
  // historique, même si l'utilisateur modifie ensuite manuellement la cible).
  bmr  Float
  tdee Float

  calorieTarget Int
  proteinG      Int
  carbsG        Int
  fatG          Int

  isManualOverride Boolean @default(false)
  notes            String?

  createdAt DateTime @default(now())
}

// Catalogue par foyer (pas de base d'ingrédients globale à administrer).
model Ingredient {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id])

  name     String
  category IngredientCategory
  baseUnit Unit

  // Valeurs nutritionnelles pour 100 g ou 100 ml (selon baseUnit).
  caloriesPer100 Float
  proteinPer100  Float
  carbsPer100    Float
  fatPer100      Float

  createdAt DateTime @default(now())

  recipeIngredients RecipeIngredient[]
  shoppingListItems ShoppingListItem[]
}

model Recipe {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id])

  name         String
  instructions String?
  servings     Int      @default(1)

  createdAt DateTime @default(now())

  ingredients  RecipeIngredient[]
  plannedMeals PlannedMeal[]
}

// Relation many-to-many avec quantité (exprimée dans l'unité de l'ingrédient).
model RecipeIngredient {
  id           String     @id @default(cuid())
  recipeId     String
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])

  quantity Float

  @@unique([recipeId, ingredientId])
}

// Un repas planifié pour un jour + créneau donné. Un seul par (foyer, jour,
// créneau) : réassigner une recette sur le même créneau remplace l'existant.
model PlannedMeal {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id])

  date     DateTime // jour seul (minuit UTC) ; l'heure n'est pas utilisée
  mealSlot MealSlot

  recipeId          String
  recipe            Recipe @relation(fields: [recipeId], references: [id])
  portionMultiplier Float  @default(1)

  createdAt DateTime @default(now())

  attendances MealAttendance[]

  @@unique([householdId, date, mealSlot])
}

// Quels membres du foyer mangent ce repas planifié.
model MealAttendance {
  id            String      @id @default(cuid())
  plannedMealId String
  plannedMeal   PlannedMeal @relation(fields: [plannedMealId], references: [id], onDelete: Cascade)
  memberId      String
  member        Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([plannedMealId, memberId])
}

// Générée à partir d'une plage de dates du planning (voir
// features/shopping-list/aggregate.ts pour le calcul).
model ShoppingList {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id])

  name String
  // Optionnelles : une liste n'est plus forcément générée à partir d'une
  // plage de dates du planning (voir importPlannedMeals) — elle peut être
  // un simple panier créé à la main. Gardées pour l'affichage des listes
  // historiques créées avec l'ancien flux (une seule génération = une plage).
  startDate DateTime?
  endDate   DateTime?

  createdAt DateTime @default(now())

  items ShoppingListItem[]
}

model ShoppingListItem {
  id             String       @id @default(cuid())
  shoppingListId String
  shoppingList   ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)

  // Lien optionnel vers l'ingrédient source (null pour un article ajouté
  // manuellement). name/category sont toujours copiés à la création, donc
  // l'affichage ne dépend jamais de ce lien et reste stable même si
  // l'ingrédient source est ensuite renommé ou supprimé.
  ingredientId String?
  ingredient   Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: SetNull)
  name         String

  category IngredientCategory
  quantity Float
  unit     Unit

  isChecked Boolean @default(false)
}

enum MealSlot {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum Unit {
  GRAM
  MILLILITER
}

enum IngredientCategory {
  OTHER
  FRUITS_VEGETABLES
  MEAT
  FISH
  BAKERY
  FRESH
  FROZEN
  BEVERAGES
  STARCHES
  SAVORY_GROCERY
  CANNED
  READY_MEALS
  SAUCES_CONDIMENTS
  BREAKFAST
  COOKIES_CAKES
  CONFECTIONERY
  DESSERT
  BEAUTY_HYGIENE
  BABY
  CLEANING
  PETS
  HOME_GARDEN
  CONDIMENTS
}

enum MemberRole {
  OWNER
  ADULT
  CHILD
}

enum Sex {
  MALE
  FEMALE
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}
