# Copie ce fichier en ".env.local" (ignoré par git) et remplis les vraies valeurs.
# Ne jamais committer de vraies clés/secrets.

# --- Supabase (bouton "Connect" sur le dashboard du projet) ---
# URL et clé publique du projet. Sûres à exposer au client (onglet "App Frameworks" > Next.js).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Connexions Postgres utilisées par Prisma (onglet "ORMs" > Prisma). Restent strictement
# côté serveur, jamais préfixées par NEXT_PUBLIC_. Le mot de passe doit être encodé pour l'URL
# (ex: "#" -> "%23") s'il contient des caractères spéciaux.
# DATABASE_URL : pooler en mode transaction (port 6543) - utilisée à l'exécution par l'app.
DATABASE_URL=
# DIRECT_URL : pooler en mode session (port 5432) - utilisée par les migrations Prisma.
DIRECT_URL=

# --- Assistant IA (coordinateur + agent cuisine) — côté serveur uniquement ---
# Clé API Anthropic (console.anthropic.com > Settings > API Keys). Sans elle, la page
# /assistant affiche la marche à suivre et le reste de l'application fonctionne normalement.
# Ne jamais la préfixer par NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
# Optionnel : modèle utilisé par les agents (défaut : claude-opus-5-5).
AI_MODEL=
