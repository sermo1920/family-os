# Copie ce fichier en ".env.local" (ignoré par git) et remplis les vraies valeurs.
# Ne jamais committer de vraies clés/secrets.

# --- Supabase (créé en Phase 1) ---
# URL et clé publique du projet Supabase (Project Settings > API). Sûres à exposer au client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Connexion Postgres utilisée par Prisma (Project Settings > Database > Connection string).
# Reste strictement côté serveur, jamais préfixée par NEXT_PUBLIC_.
DATABASE_URL=
